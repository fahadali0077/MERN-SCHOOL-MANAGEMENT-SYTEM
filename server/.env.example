# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas: https://cloud.mongodb.com → Clusters → Connect → Driver
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/schoolms?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Upstash: https://console.upstash.com → Create Database → Copy "rediss://" URL
# Note: must start with rediss:// (TLS) not redis://
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ─── Frontend URL (for CORS + email links) ───────────────────────────────────
CLIENT_URL=https://your-app.vercel.app

# ─── Cloudinary (file uploads) ───────────────────────────────────────────────
# https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email ────────────────────────────────────────────────────────────────────
# Provider priority: BREVO_API_KEY → SENDGRID_API_KEY → SMTP_* → (dev) Ethereal.
#
# RECOMMENDED: Brevo (https://app.brevo.com → SMTP & API → SMTP).
#   - BREVO_API_KEY   : the SMTP key shown there (starts with "xkeysib-")
#   - BREVO_SMTP_USER : the "Login" on that same page (e.g. 8a1b2c@smtp-brevo.com)
#   - EMAIL_FROM      : a sender you've verified in Brevo (Senders & IP)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
BREVO_SMTP_USER=8xxxxx@smtp-brevo.com
EMAIL_FROM=noreply@yourschool.com

# Alternative providers (leave the above unset to use one of these):
# SENDGRID_API_KEY=SG.xxxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password_16chars

# ─── SMS (Twilio) — optional ─────────────────────────────────────────────────
# Used by services/sms.service.js. If unset, SMS sending is disabled gracefully.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+15551234567
